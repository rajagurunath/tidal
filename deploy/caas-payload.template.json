{
  "resource_private_name": "${RESOURCE_PRIVATE_NAME}",
  "device_id": "${DEVICE_ID}",
  "duration_hours": 12,
  "gpus_per_container": 1,
  "hardware_id": "${HARDWARE_ID}",
  "node_pool_id": "${NODE_POOL_ID}",
  "container_config": {
    "replica_count": 1,
    "env_variables": {
      "created_by": "${CREATED_BY}",
      "MODE": "selfdrive",
      "CAAS": "1",
      "PORT": "8000",
      "RESULTS_DIR": "/results",
      "MODEL": "${MODEL}",
      "TENSOR_PARALLEL_SIZE": "${TENSOR_PARALLEL_SIZE}",
      "MAX_MODEL_LEN": "${MAX_MODEL_LEN}",
      "ONLINE_RPS": "${ONLINE_RPS}",
      "MINUTES": "${MINUTES}",
      "BATCH_CONCURRENCY": "${BATCH_CONCURRENCY}",
      "DIURNAL_MINUTES": "${DIURNAL_MINUTES}",
      "DEADLINE_MINUTES": "${DEADLINE_MINUTES}",
      "DEADLINE_TIGHTNESS": "${DEADLINE_TIGHTNESS}",
      "MAX_INFLIGHT": "${MAX_INFLIGHT}",
      "CASE_TIMEOUT_S": "${CASE_TIMEOUT_S}",
      "RUN_CANARY": "1",
      "TIDAL_RESULTS_HF_REPO": "${TIDAL_RESULTS_HF_REPO}",
      "VLLM_LOG_STATS_INTERVAL": "1",
      "VLLM_RPC_TIMEOUT": "600000",
      "VLLM_ENGINE_READY_TIMEOUT_S": "3600",
      "HF_HUB_ENABLE_HF_TRANSFER": "1",
      "internal_logging_enabled": "true"
    },
    "secret_env_variables": {
      "HF_TOKEN": "${HF_TOKEN}",
      "HUGGING_FACE_HUB_TOKEN": "${HF_TOKEN}",
      "TIDAL_API_KEY": "${TIDAL_API_KEY}"
    },
    "entrypoint": ["/usr/local/bin/tidal-engine-entrypoint"],
    "traffic_port": 8000,
    "args": [],
    "command": ""
  },
  "registry_config": {
    "image_url": "${ENGINE_IMAGE}",
    "registry_username": "${REGISTRY_USERNAME}",
    "registry_secret": "${REGISTRY_SECRET}"
  }
}
