# syntax=docker/dockerfile:1.7
#
# Tidal gateway image — technique A's sidecar. No CUDA, no torch, no vLLM.
#
# Build context is the REPO ROOT:
#
#   docker build -f deploy/Dockerfile.gateway -t tidal-gateway:latest .
#
# Runs `tidal serve`: the OpenAI-wire /v1/files + /v1/batches surface, the
# durable store, and the AIMD dispatcher that drives batch work into whatever
# engine TIDAL_VLLM_BASE_URL points at. Every knob in src/tidal/config.py is
# settable as TIDAL_<FIELD_NAME_UPPER>.

ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/

# hadolint ignore=DL3042
RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --wheel-dir /wheels .


FROM ${PYTHON_IMAGE} AS gateway

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Non-root: the gateway holds customer batch payloads and needs nothing
# privileged. /data is the only writable path it requires.
RUN useradd --create-home --uid 10001 tidal \
    && mkdir -p /data/blobs \
    && chown -R tidal:tidal /data

COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels tidal-serve \
    && rm -rf /wheels

# Defaults are container-shaped: bind all interfaces, keep state under /data.
# `engine` is the compose service name; override for CaaS/standalone.
ENV TIDAL_HOST=0.0.0.0 \
    TIDAL_PORT=8080 \
    TIDAL_VLLM_BASE_URL=http://engine:8000 \
    TIDAL_VLLM_METRICS_URL=http://engine:8000/metrics \
    TIDAL_DSN=sqlite:////data/tidal.db \
    TIDAL_BLOB_DIR=/data/blobs \
    TIDAL_MAX_INFLIGHT=64

# TIDAL_API_KEY is deliberately NOT defaulted here. `tidal serve` warns loudly
# when it binds a non-loopback address while the key is still the placeholder
# `tidal-dev-key`; baking a default into the image would make that warning
# permanent background noise. Set it in compose / the CaaS payload.

USER tidal
WORKDIR /data
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('TIDAL_PORT','8080')+'/healthz', timeout=4)" || exit 1

ENTRYPOINT ["tidal"]
CMD ["serve"]
