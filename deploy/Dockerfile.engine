# syntax=docker/dockerfile:1.7
#
# Tidal engine image — vLLM on GPU with the Tidal package baked in.
#
# Build context is the REPO ROOT, not deploy/:
#
#   docker build -f deploy/Dockerfile.engine -t tidal-engine:fast .
#
# Two build paths, selected by BUILD_MODE:
#
#   BUILD_MODE=fast   (default, ~3 min)
#       FROM a published vllm/vllm-openai release + `pip install --no-deps` of
#       this repo. Technique B rides on TidalScheduler's startup capability
#       probe: mechanisms whose upstream hooks are missing degrade individually
#       and are named in the `capabilities=` log line, so a vLLM that has
#       drifted away from the plan-B pin still boots and still serves.
#
#   BUILD_MODE=pinned (~30-60 min, GPU-class builder, several GB of ccache)
#       Compiles vLLM from source at the commit plan B was written against
#       (e6d67fdd). Use only when the fast path's capability probe reports
#       something you actually need as missing. Read the caveat in
#       deploy/README.md first: the *supported* way to get a pinned build is to
#       run vLLM's own docker/Dockerfile at that commit and then feed the
#       result back into the fast path via --build-arg VLLM_IMAGE=<your tag>.
#
# All ARGs before the first FROM are global and referenced by the FROM lines,
# so BuildKit only materializes the stage BUILD_MODE selects.

ARG BUILD_MODE=fast

# The published vLLM release the fast path sits on. VERIFY THIS TAG EXISTS
# before building — see deploy/README.md; the tag list moves weekly and this
# default was not network-verified.
ARG VLLM_IMAGE=vllm/vllm-openai:v0.26.0

# Base for the pinned source build.
ARG VLLM_BUILD_BASE=nvidia/cuda:12.8.1-devel-ubuntu24.04


# --------------------------------------------------------------------------
# Path (a) — FAST. Stock published vLLM.
# --------------------------------------------------------------------------
FROM ${VLLM_IMAGE} AS base-fast


# --------------------------------------------------------------------------
# Path (b) — PINNED. vLLM compiled from source at the plan-B commit.
# --------------------------------------------------------------------------
FROM ${VLLM_BUILD_BASE} AS base-pinned

# Commit plan B (docs/plans/*-plan-B-engine.md) verified its interface points
# against: schedule(), SchedulingPolicy.PRIORITY preemption, _preempt_request,
# update_from_output, SchedulerConfig.scheduler_cls.
ARG VLLM_COMMIT=e6d67fdd
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
# H100/H200 = 9.0. B200 = 10.0. Narrow this to your target: every extra arch is
# another full kernel compile.
ARG TORCH_CUDA_ARCH_LIST=9.0
ARG MAX_JOBS=16
# Must match VLLM_BUILD_BASE's CUDA minor version.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

ENV DEBIAN_FRONTEND=noninteractive \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    MAX_JOBS=${MAX_JOBS} \
    VLLM_TARGET_DEVICE=cuda \
    CCACHE_DIR=/root/.cache/ccache \
    PATH=/usr/lib/ccache:$PATH

# hadolint ignore=DL3008,DL3009
RUN apt-get update && apt-get install --no-install-recommends -y \
        ca-certificates \
        ccache \
        cmake \
        curl \
        git \
        ninja-build \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# A venv sidesteps PEP 668 on ubuntu:24.04 (externally-managed-environment).
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH VIRTUAL_ENV=/opt/venv

# hadolint ignore=DL3013,DL3042
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel

# hadolint ignore=DL3013,DL3042
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch torchvision torchaudio --index-url "${TORCH_INDEX_URL}"

RUN git clone --filter=blob:none "${VLLM_REPO}" /opt/vllm-src \
    && git -C /opt/vllm-src checkout "${VLLM_COMMIT}"

WORKDIR /opt/vllm-src

# This is the 30-60 minute step. Kernel compilation dominates; the ccache mount
# makes a rebuild at the same commit cheap, a different commit not much cheaper.
# hadolint ignore=DL3013,DL3042
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/ccache \
    pip install -r requirements/build.txt \
    && pip install --no-build-isolation -e . \
    && ccache -s

WORKDIR /


# --------------------------------------------------------------------------
# Common layer — Tidal on top of whichever base was selected.
# --------------------------------------------------------------------------
# hadolint ignore=DL3006
FROM base-${BUILD_MODE} AS engine

# Install the eval harness's extra dependencies so the full A/B matrix can be
# run from inside this container (that is where the `vllm` binary lives, and
# the harness launches its own engine per condition). Set to 0 for a pure
# serving image.
ARG INSTALL_EVAL_EXTRAS=1
# Import-check tidal.engine.scheduler against this image's vLLM at build time,
# so version drift fails the build instead of failing on the GPU node. Set to 0
# when cross-building under QEMU (importing torch emulated is pathologically
# slow).
ARG VERIFY_IMPORTS=1

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/root/.cache/huggingface \
    PYTHONPATH=/opt/tidal/src

WORKDIR /opt/tidal

# Copy only what the package and the canary test need. Notably tests/ comes
# along: the 10-minute compat canary (tests/unit/test_tidal_scheduler.py)
# imports tests.unit.engine_fixtures and is the fastest way to tell whether this
# image's vLLM still satisfies TidalScheduler's assumptions.
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
COPY tests/ ./tests/

# --no-deps is load-bearing. The vLLM base image pins numpy/pydantic/fastapi to
# versions its compiled kernels agree with; letting tidal's own ranges resolve
# would happily upgrade them out from under the engine. Everything tidal's
# engine plugin actually imports (numpy, stdlib) is already present.
# hadolint ignore=DL3042
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps .

# Pure-python extras: safe to resolve normally, none of them touch torch/CUDA.
# hadolint ignore=DL3013,DL3042
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "${INSTALL_EVAL_EXTRAS}" = "1" ]; then \
        pip install \
            "sqlalchemy>=2.0" \
            "typer>=0.12" \
            "python-multipart>=0.0.9" \
            "openai>=1.40" \
            "matplotlib>=3.8" \
            "pytest>=8.0" \
            "pytest-asyncio>=0.23" ; \
    fi

RUN if [ "${VERIFY_IMPORTS}" = "1" ]; then \
        python3 -c "import tidal, tidal.engine.scheduler as s; print('tidal ok:', s.TidalScheduler)" ; \
    fi

COPY deploy/engine-entrypoint.sh /usr/local/bin/tidal-engine-entrypoint
RUN chmod +x /usr/local/bin/tidal-engine-entrypoint

COPY deploy/run_gpu_eval.sh /usr/local/bin/tidal-run-gpu-eval
RUN chmod +x /usr/local/bin/tidal-run-gpu-eval

ENV SCHEDULER_MODE=stock \
    MODEL=Qwen/Qwen2.5-7B-Instruct \
    MAX_MODEL_LEN=8192 \
    TBT_SLO=200 \
    TENSOR_PARALLEL_SIZE=1 \
    PORT=8000

EXPOSE 8000

# /health is unauthenticated in vLLM even when --api-key is set.
HEALTHCHECK --interval=30s --timeout=5s --start-period=25m --retries=5 \
    CMD python3 -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/health', timeout=4)" || exit 1

ENTRYPOINT ["/usr/local/bin/tidal-engine-entrypoint"]
